# Copy this file to .env and adjust.

# Sub-domain that points to this server (A record), e.g. dl.mp3convert.tools
DOMAIN=dl.mp3convert.tools

# Website origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://mp3convert.tools,https://www.mp3convert.tools

# Limits
MAX_DURATION_SECONDS=10800
MAX_FILESIZE=1500M
MAX_CONCURRENT_JOBS=3
JOBS_PER_IP_PER_HOUR=20
INFO_PER_IP_PER_HOUR=60
FILE_TTL_MINUTES=30
JOB_TIMEOUT_MINUTES=30

# Optional: residential/rotating proxy if YouTube blocks the server
# ("Sign in to confirm you're not a bot" or "Failed to extract any player response" in the logs)
# YTDLP_PROXY=http://user:pass@proxy.example.com:8000
# Use the proxy only for these sites, to keep proxy costs down (empty = all links)
# YTDLP_PROXY_DOMAINS=youtube.com,youtu.be
# Advanced: extra yt-dlp extractor options
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default

# Comma-separated domains or URL fragments to block (e.g. after a DMCA notice)
# BLOCKLIST=example.com,watch?v=VIDEO_ID

# Retry when a site blocks the request (each retry gets a new IP with a rotating proxy)
BLOCK_RETRIES=2
# Reuse finished files for the same video/format/quality (0 = off)
CACHE_TTL_MINUTES=360
CACHE_MAX_MB=1000
# Remember video details (title, formats) to avoid repeat lookups
INFO_CACHE_MINUTES=30
